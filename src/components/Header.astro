---
import site from '../data/site.json';
import ThemeToggle from './ThemeToggle.astro';
const nav = [
  ['Projects', '#projects'], ['Skills', '#skills'], ['Education', '#education'],
  ['About', '#about'], ['Contact', '#contact'],
];
const resume = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${site.resume.file}`;
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="#top" aria-label={`${site.name}, back to top`}><span class="wordmark__mark mono" aria-hidden="true"><b>{`{`}</b>{site.shortName}<b>{`}`}</b></span><span class="wordmark__name">{site.name}</span></a>
    <ThemeToggle />
    <nav class="site-nav" aria-label="Sections">
      <ul>
        {nav.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        <li class="site-nav__resume"><a class="btn btn--secondary btn--sm" href={resume} download>Resume</a></li>
      </ul>
    </nav>
  </div>
</header>
